# A throwaway Samba Active Directory domain controller for the integration
# tests (tests/integration/run_samba_ad.sh builds and starts it). Debian's
# own Samba packages on a pinned Debian image; everything is provisioned
# at build time, so a container is up in a few seconds:
#
# - realm CORO.TEST, NetBIOS domain CORO, DC DC1 (DC1.coro.test), no DNS
#   server (--dns-backend=NONE: the tests connect by address);
# - Administrator's password Adm1n-Passw0rd;
# - the users of tests/integration/samba_ad_tests.cpp, below;
# - OU=Ranged: 1600 contacts and CN=large-group holding them all, more
#   members than MaxValRange (1500) for ranged retrieval;
# - the password policy: complexity and a minimum length of 7 as Samba
#   provisions them, but no minimum age (a user may change a password just
#   reset, as the tests do) and no history (the tests set the same
#   passwords again);
# - the DC's LDAP service principal ldap/dc1.coro.test, for SASL GSSAPI
#   (samba_spnupdate, which would register it, runs with the dnsupdate
#   service this image leaves out);
# - Samba's own self-signed TLS certificate (private/tls: ca.pem, cert.pem
#   for CN=DC1.coro.test, no subjectAltName), generated by starting samba
#   once, so every container of the image serves the same one.
#
# Unprivileged: the NT ACLs Samba keeps on the sysvol go in user.NTACL
# extended attributes, which overlayfs allows without CAP_SYS_ADMIN, rather
# than security.NTACL. `ldap server require strong auth` is not in
# smb.conf: run_samba_ad.sh passes it to samba with --option.
#
# Every secret here is a throwaway test value.
FROM debian:trixie-20261027-slim

RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		samba-ad-dc samba-ad-provision samba ldb-tools \
	&& rm -rf /var/lib/apt/lists/*

RUN rm -f /etc/samba/smb.conf \
	&& samba-tool domain provision --realm=CORO.TEST --domain=CORO --host-name=dc1 \
		--server-role=dc --dns-backend=NONE --adminpass='Adm1n-Passw0rd' \
		--option='acl_xattr:security_acl_name = user.NTACL' \
	&& sed -i 's/, dnsupdate//' /etc/samba/smb.conf \
	&& samba-tool domain passwordsettings set --min-pwd-age=0 --history-length=0 \
	&& samba-tool user add alice 'Al1ce-Passw0rd' --use-username-as-cn \
	&& samba-tool user add 'jörg' 'Jörg-𝄞-Pässw0rd' --use-username-as-cn \
	&& samba-tool user add pwchange 'Initial-Passw0rd' --use-username-as-cn \
	&& samba-tool user add large 'Large-Passw0rd' --use-username-as-cn \
	&& samba-tool spn add ldap/dc1.coro.test 'DC1$' \
	&& { printf 'dn: OU=Ranged,DC=coro,DC=test\nobjectClass: organizationalUnit\n\n'; \
		for i in $(seq -w 0 1599); do printf 'dn: CN=m%s,OU=Ranged,DC=coro,DC=test\nobjectClass: contact\n\n' "$i"; done; \
		printf 'dn: CN=large-group,OU=Ranged,DC=coro,DC=test\nobjectClass: group\n'; \
		for i in $(seq -w 0 1599); do printf 'member: CN=m%s,OU=Ranged,DC=coro,DC=test\n' "$i"; done; } > /tmp/ranged.ldif \
	&& ldbadd -H /var/lib/samba/private/sam.ldb /tmp/ranged.ldif > /dev/null \
	&& rm -f /tmp/ranged.ldif \
	&& (samba --foreground --no-process-group & pid=$!; \
		for _ in $(seq 300); do [ -s /var/lib/samba/private/tls/cert.pem ] && break; sleep 0.1; done; \
		kill "$pid"; wait "$pid" || true) \
	&& test -s /var/lib/samba/private/tls/ca.pem

EXPOSE 88 389 636
CMD ["samba", "--foreground", "--no-process-group", "--debug-stdout"]
