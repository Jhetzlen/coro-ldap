# find_package(jhetz_ldap): jhetz::ldap (component `net`, the default),
# `core` for jhetz::ldap_core alone, `ad` for jhetz::ldap_ad and `gssapi`
# for SASL GSSAPI; their dependencies are found here.
@PACKAGE_INIT@

if(NOT jhetz_ldap_FIND_COMPONENTS)
    set(jhetz_ldap_FIND_COMPONENTS net)
    set(jhetz_ldap_FIND_REQUIRED_net TRUE)
endif()
set(jhetz_ldap_core_FOUND TRUE)
foreach(_jhetz_ldap_component net ad)
    set(jhetz_ldap_${_jhetz_ldap_component}_FOUND @JHETZ_LDAP_PACKAGE_NET@)
endforeach()
set(jhetz_ldap_gssapi_FOUND @JHETZ_LDAP_PACKAGE_GSSAPI@)
include(CMakeFindDependencyMacro)
# Linked privately: a static jhetz::ldap_core needs it at link time, a
# shared one as a dependent library.
find_dependency(ICU 60 COMPONENTS uc data)
if(@JHETZ_LDAP_PACKAGE_NET@)
    find_dependency(boost_corosio CONFIG)
    if(jhetz_ldap_gssapi_FOUND AND NOT WIN32)
        # The same: the target jhetz::ldap links, PkgConfig::JHETZ_LDAP_GSSAPI
        # (on Windows secur32, nothing to find).
        find_dependency(PkgConfig)
        if(NOT TARGET PkgConfig::JHETZ_LDAP_GSSAPI)
            pkg_search_module(JHETZ_LDAP_GSSAPI IMPORTED_TARGET krb5-gssapi heimdal-gssapi)
        endif()
        if(NOT TARGET PkgConfig::JHETZ_LDAP_GSSAPI)
            set(jhetz_ldap_FOUND FALSE)
            set(jhetz_ldap_NOT_FOUND_MESSAGE "jhetz::ldap needs the GSS-API library (pkg-config krb5-gssapi)")
            return()
        endif()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/jhetz_ldap-targets.cmake")
check_required_components(jhetz_ldap)
