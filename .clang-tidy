# clang-tidy configuration for coro-ldap (docs/DEVELOPMENT.md, "clang-tidy").
# Run through -DJHETZ_LDAP_CLANG_TIDY=ON (our own targets only) or
# run-clang-tidy over build/tidy/compile_commands.json. tests/.clang-tidy and
# fuzz/.clang-tidy inherit this file and turn off test-only noise.
#
# Every disabled check has its reason on the line above it.
Checks:
  - -*
  - bugprone-*
  - cert-*
  - clang-analyzer-*
  - concurrency-*
  - cppcoreguidelines-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*
  # Style: short names (i, n, ec, os, dn, id) are idiomatic here.
  - -readability-identifier-length
  # Style: clang-format decides on trailing commas in braced lists.
  - -readability-trailing-comma
  # Style: lower-case literal suffixes (0u, 1ull) are used throughout.
  - -readability-uppercase-literal-suffix
  # Style: x.static_member() through an instance is fine.
  - -readability-static-accessed-through-instance
  # Style: top-level const on by-value parameters is not repeated in declarations.
  - -readability-avoid-const-params-in-decls
  # Unnamed parameters deliberately mark unused ones (overloads, tags, callbacks).
  - -readability-named-parameter
  # 'T member{};' on aggregate members is deliberate: designated initializers
  # that omit the member stay quiet under -Wmissing-field-initializers.
  - -readability-redundant-member-init
  # BER, filters and DNs are trees: the recursive walkers are depth-limited.
  - -misc-no-recursion
  # Internal linkage is chosen per file (static vs anonymous namespace).
  - -misc-use-anonymous-namespace
  - -misc-use-internal-linkage
  # No IWYU mapping for Capy/Corosio umbrella headers and our detail headers;
  # the -Werror GCC and Clang builds catch a missing include.
  - -misc-include-cleaner
  # The codec indexes spans and strings after explicit length checks; .at()
  # or gsl::span would add throws to a non-throwing decoder.
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic
  # char/std::byte views of buffers and the C APIs (OpenSSL, GSS-API,
  # sockaddr) need reinterpret_cast.
  - -cppcoreguidelines-pro-type-reinterpret-cast
  # No GSL: ownership is RAII (unique_ptr with deleters for the C APIs).
  - -cppcoreguidelines-owning-memory
  # Capy tasks are lazy and awaited at once by the caller, whose frame owns
  # the referenced arguments; by-reference parameters are the Capy idiom.
  - -cppcoreguidelines-avoid-reference-coroutine-parameters
  # pmr types: move assignment copies when the allocators differ, so it is
  # not noexcept (the defaulted ones get the right exception specification).
  - -cppcoreguidelines-noexcept-move-operations
  - -performance-noexcept-move-constructor
  # Linux-only project; every header uses #pragma once.
  - -portability-avoid-pragma-once
  # do { } while is fine for retry loops (GSS-API status message loop).
  - -cppcoreguidelines-avoid-do-while
  # An enum's underlying type is API and ABI; errc enums feed std::error_code (int).
  - -performance-enum-size
# The tree is clean: every finding is an error (fix it, or NOLINT a false
# positive with its reason).
WarningsAsErrors: '*'
# Our own headers only: never Corosio, Capy, Catch2 or the system headers.
HeaderFilterRegex: '.*/(include/jhetz|src|tests|fuzz)/.*'
ExcludeHeaderFilterRegex: '.*/_deps/.*'
# The dependencies are SYSTEM includes, but a static-analyzer report whose
# path starts in our code is kept even when its final location is in their
# headers, where no NOLINT can reach it. Report every analyzer finding in the
# main file instead (with the path in the notes), so a false positive is
# silenced by a NOLINT on our line. clang-tidy cannot set this global analyzer
# option through CheckOptions (only checker options), hence the -Xclang pair.
ExtraArgs:
  - '-Xclang'
  - '-analyzer-config'
  - '-Xclang'
  - 'report-in-main-source-file=true'
FormatStyle: none

CheckOptions:
  # The decoders and parsers are long state machines; flag only the worst.
  readability-function-cognitive-complexity.Threshold: 40
  readability-function-cognitive-complexity.IgnoreMacros: true
  # 'x << 16' with a positive literal is not a signedness hazard.
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
  # 'if (ptr)' is the idiom for the C API handles and lookups returning pointers.
  readability-implicit-bool-conversion.AllowPointerConditions: true
  # Magic numbers (tests and fuzz turn the checks off): 0-4, the
  # decimal radix, powers of two (bit masks, shift widths, 8 bits per octet,
  # buffer and arena sizes) and the 0xFF octet mask read as themselves;
  # anything else gets a named constant.
  readability-magic-numbers.IgnoredIntegerValues: '1;2;3;4;10;255'
  readability-magic-numbers.IgnorePowersOf2IntegerValues: true
  cppcoreguidelines-avoid-magic-numbers.IgnoredIntegerValues: '1;2;3;4;10;255'
  cppcoreguidelines-avoid-magic-numbers.IgnorePowersOf2IntegerValues: true
  # Messages, controls and requests are structs with all-public data (some
  # with allocator-extended constructors): only a class mixing public data
  # with private or protected members is reported.
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  # '(void)f()' is the explicit way to drop a result here.
  bugprone-unused-return-value.AllowCastToVoid: true
  # pmr move assignment may allocate (see noexcept-move-operations above).
  bugprone-exception-escape.CheckMoveMemberFunctions: false
  # Allocator-extended move constructors move member by member.
  cppcoreguidelines-rvalue-reference-param-not-moved.AllowPartialMove: true
  # Non-copyable RAII guards do not need move operations spelled out.
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  cppcoreguidelines-special-member-functions.AllowImplicitlyDeletedCopyOrMove: true
  # Trailing return types on functions only; lambdas keep their deduced return type.
  modernize-use-trailing-return-type.TransformLambdas: none
  # Mixed integer widths or signedness (size_t/uint32_t, size_t/char) are not
  # reported as swappable: a swap narrows or changes sign in one direction,
  # which -Wconversion -Wsign-conversion turn into an error (jhetz_ldap_warnings,
  # every target). Same-typed adjacent parameters are still reported.
  bugprone-easily-swappable-parameters.ModelImplicitConversions: false
  # The check's default names, plus 'what': the label of an error message
  # (check_text(s, what), quoted(what, text)); a swap only garbles a diagnostic.
  bugprone-easily-swappable-parameters.IgnoredParameterNames: '"";iterator;Iterator;begin;Begin;end;End;first;First;last;Last;lhs;LHS;rhs;RHS;what'
